         <catDesc xml:lang="de"><term>Kammern</term></catDesc>
         <catDesc xml:lang="fr"><term>Chambres</term></catDesc>
         <catDesc xml:lang="it"><term>Camere</term></catDesc>
         <category xml:id="parla.uni">
            <catDesc xml:lang="en"><term>Unicameralism</term></catDesc>
            <catDesc xml:lang="de"><term>Einkammernsystem</term></catDesc>
