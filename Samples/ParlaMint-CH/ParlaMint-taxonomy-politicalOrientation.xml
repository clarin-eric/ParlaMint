      <catDesc xml:lang="en"><term>Left</term></catDesc>
      <catDesc xml:lang="de"><term>Rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.C">
      <catDesc xml:lang="en"><term>Centre</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre</term></catDesc>
      <catDesc xml:lang="it"><term>Centro</term></catDesc>
   </category>
   <category xml:id="orientation.R">
      <catDesc xml:lang="en"><term>Right</term></catDesc>
      <catDesc xml:lang="de"><term>Rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Droite</term></catDesc>
      <catDesc xml:lang="it"><term>Destra</term></catDesc>
   </category>
   <category xml:id="orientation.FL">
      <catDesc xml:lang="en"><term>Far-left</term></catDesc>
      <catDesc xml:lang="de"><term>Extrem Links</term></catDesc>
      <catDesc xml:lang="fr"><term>Extrême gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Estrema sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.FR">
      <catDesc xml:lang="en"><term>Far-right</term></catDesc>
      <catDesc xml:lang="de"><term>Extrem Rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Extrême droie</term></catDesc>
      <catDesc xml:lang="it"><term>Estrema destra</term></catDesc>
   </category>
   <category xml:id="orientation.CL">
      <catDesc xml:lang="en"><term>Centre-left</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte-links</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Centro-sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.CR">
      <catDesc xml:lang="en"><term>Centre-right</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte-rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre droit</term></catDesc>
      <catDesc xml:lang="it"><term>Centro-destra</term></catDesc>
   </category>
   <category xml:id="orientation.CCL">
      <catDesc xml:lang="en"><term>Centre to centre-left</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte bis Mitte-links</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre à centre gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Centro verso centro-sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.CCR">
      <catDesc xml:lang="en"><term>Centre to centre-right</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte bis Mitte-rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre à centre droit</term></catDesc>
      <catDesc xml:lang="it"><term>Centro verso centro-destra</term></catDesc>
   </category>
   <category xml:id="orientation.CLL">
      <catDesc xml:lang="en"><term>Centre-left to left</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte-links bis Links</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre gauche à gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Centro-sinistra verso sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.CRR">
      <catDesc xml:lang="en"><term>Centre-right to right</term></catDesc>
      <catDesc xml:lang="de"><term>Mitte-rechts bis Rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Centre droit à droite</term></catDesc>
      <catDesc xml:lang="it"><term>Centro-destra verso destra</term></catDesc>
   </category>
   <category xml:id="orientation.LLF">
      <catDesc xml:lang="en"><term>Left to far-left</term></catDesc>
      <catDesc xml:lang="de"><term>Links bis extrem Links</term></catDesc>
      <catDesc xml:lang="fr"><term>Gauche à centre gauche</term></catDesc>
      <catDesc xml:lang="it"><term>Sinistra verso estrema sinistra</term></catDesc>
   </category>
   <category xml:id="orientation.RRF">
      <catDesc xml:lang="en"><term>Right to far-right</term></catDesc>
      <catDesc xml:lang="de"><term>Rechts bis extrem Rechts</term></catDesc>
      <catDesc xml:lang="fr"><term>Droite à extrême droite</term></catDesc>
      <catDesc xml:lang="it"><term>Destra verso estrema destra</term></catDesc>
   </category>
   <category xml:id="orientation.BT">
      <catDesc xml:lang="en"><term>Big tent</term>: <ref target="https://en.wikipedia.org/wiki/Big_tent">Big tent</ref> or catch-all refers to political parties that have members covering a broad spectrum of beliefs.</catDesc>
      <catDesc xml:lang="de"><term>"Catch-all" Partei</term></catDesc>
      <catDesc xml:lang="fr"><term>Parti attrape-tout</term></catDesc>
      <catDesc xml:lang="it"><term>Pigliatutto</term>: <ref target="https://it.wikipedia.org/wiki/Partito_pigliatutto">Partito pigliatutto</ref>, o pigliatutti (in inglese: catch-all party, definizione coniata da Otto Kirchheimer), a volte grande tenda (in inglese: big tent), è un tipo di partito politico che sorge nel secondo dopoguerra per l'esigenza, da parte dei partiti di massa, di attrarre il consenso del massimo numero di elettori e di trascendere dunque gli interessi di gruppo al fine di conquistare una fiducia generale.</catDesc>
   </category>
   <category xml:id="orientation.NP">
      <catDesc xml:lang="en"><term>Nonpartisanism</term>: <ref target="https://en.wikipedia.org/wiki/Nonpartisanism">Nonpartisanism</ref> refers to a political stance that does not agree with the current political party system.</catDesc>
      <catDesc xml:lang="de"><term>Überparteilichkeit</term></catDesc>
      <catDesc xml:lang="fr"><term>Non-partisanerie</term></catDesc>
      <catDesc xml:lang="it"><term>Non-partisan</term>: si riferisce a una posizione politica che non è d’accordo con l’attuale sistema dei partiti politici</catDesc>
   </category>
   <category xml:id="orientation.PP">
      <catDesc xml:lang="en"><term>Pirate Party</term>: <ref target="https://en.wikipedia.org/wiki/Pirate_Party">Pirate Party</ref> refers to political parties that support civil rights, direct democracy, encourage innovation and creativity, free sharing of knowledge, information privacy, free speech, anti-corruption, net neutrality and oppose mass surveillance, censorship and Big Tech.</catDesc>
      <catDesc xml:lang="de"><term>Piratenpartei</term></catDesc>
      <catDesc xml:lang="fr"><term>Parti pirate</term></catDesc>
      <catDesc xml:lang="it"><term>Partito pirata</term>: <ref target="https://it.wikipedia.org/wiki/Partito_Pirata">Partito Pirata</ref> si riferisce a partiti politici che sostengono i diritti civili, la democrazia diretta, incoraggiano l'innovazione e la creatività, la libera condivisione della conoscenza, la privacy delle informazioni, la libertà di parola, la lotta alla corruzione, la neutralità della rete e si oppongono alla sorveglianza di massa, alla censura e alle Big Tech.</catDesc>
   </category>
   <category xml:id="orientation.SI">
      <catDesc xml:lang="en"><term>Single Issue Politics</term>: <ref target="https://en.wikipedia.org/wiki/Single-issue_politics">Single Issue Politics</ref> refers to a political stance that is based on one essential policy area or idea.</catDesc>
      <catDesc xml:lang="de"><term>Interessenpartei</term></catDesc>
      <catDesc xml:lang="fr"><term>Politique à sujet unique</term></catDesc>
      <catDesc xml:lang="it"><term>Movimenti monotematici</term>: <ref target="https://it.wikipedia.org/wiki/Single-issue">Single-issue</ref> si riferisce a una posizione politica impegnata nella difesa di singole questioni o materie.</catDesc>
   </category>
   <category xml:id="orientation.SY">
      <catDesc xml:lang="en"><term>Syncretic politics</term>: <ref target="https://en.wikipedia.org/wiki/Syncretic_politics">Syncretic politics</ref> refers to politics that combine elements from across the conventional left–right political spectrum.</catDesc>
      <catDesc xml:lang="de"><term>Synkretische Politik</term></catDesc>
      <catDesc xml:lang="fr"><term>Politique syncrétique</term></catDesc>
      <catDesc xml:lang="it"><term>Trasversali</term>: <ref target="https://it.wikipedia.org/wiki/Trasversalismo">Trasversalismo</ref> è una concezione politica sistematizzata come un insieme di posizioni politiche, ideologiche e partitiche che uniscono aspetti delle politiche di sinistra con quelle di destra.</catDesc>
   </category>
</taxonomy>

